// Fintech growth analytics - SYNTHETIC data. DAX measure library (117 measures).
// Paste each block into Power BI Desktop > Modeling > New measure, with the table `_Measures` selected,
// or import with Tabular Editor. Set the format string and display folder shown in the header comment.
// NOT executed in a DAX engine in this environment; logic verified with the pandas oracle (verify_phase5.py).

// ==============================================================================
// Display folder: 00 Parameters
// ==============================================================================

// Snapshot Date  |  format: yyyy-mm-dd  |  Data cut-off; all *_asof columns count events on or before this date.
Snapshot Date =
DATE(2026, 10, 31)

// SLA Hours  |  format: #,0  |  Illustrative internal resolution SLA (hours). Not a regulatory figure.
SLA Hours =
24

// Efficient Index Threshold  |  format: #,0.00  |  Cost Efficiency Index at or above this = efficient vs paid peers.
Efficient Index Threshold =
1.15

// Costly Index Threshold  |  format: #,0.00  |  Cost Efficiency Index at or below this = costly vs paid peers.
Costly Index Threshold =
0.85

// Repeat Base Months  |  format: #,0  |  Customers need this many observed months to be judged on repeat trading.
Repeat Base Months =
4

// Repeat Trader Min Months  |  format: #,0  |  Trading in at least this many calendar months = repeat trader.
Repeat Trader Min Months =
2

// ==============================================================================
// Display folder: 01 Customers and Funnel
// ==============================================================================

// Registered Customers  |  format: #,0  |  Customers registered (all cohorts).
Registered Customers =
COUNTROWS(FactCustomer)

// Mature Customers  |  format: #,0  |  Customers registered before Oct-2026; denominator for funnel rates.
Mature Customers =
CALCULATE(COUNTROWS(FactCustomer), FactCustomer[FunnelMature] = 1)

// Mature KYC Users  |  format: #,0  |  Mature customers with KYC completed (as of snapshot).
Mature KYC Users =
CALCULATE(SUM(FactCustomer[KYCDone]), FactCustomer[FunnelMature] = 1)

// Mature Bank Linked Users  |  format: #,0  |  Mature customers with a bank account linked.
Mature Bank Linked Users =
CALCULATE(SUM(FactCustomer[BankLinked]), FactCustomer[FunnelMature] = 1)

// Mature Funded Users  |  format: #,0  |  Mature customers who made a first deposit.
Mature Funded Users =
CALCULATE(SUM(FactCustomer[Deposited]), FactCustomer[FunnelMature] = 1)

// Mature First Traders  |  format: #,0  |  Mature customers who placed a first trade.
Mature First Traders =
CALCULATE(SUM(FactCustomer[Traded]), FactCustomer[FunnelMature] = 1)

// Mature Active 30d Traders  |  format: #,0  |  Mature first traders active in the last 30 days (funnel stage 6).
Mature Active 30d Traders =
CALCULATE(
    COUNTROWS(FactCustomer),
    FactCustomer[FunnelMature] = 1,
    FactCustomer[Traded] = 1,
    FactCustomer[Active30d] = 1
)

// KYC Completion Rate  |  format: 0.0%  |  KYC completed / mature registered.
KYC Completion Rate =
DIVIDE([Mature KYC Users], [Mature Customers])

// Bank Link Conversion  |  format: 0.0%  |  Bank linked / KYC completed.
Bank Link Conversion =
DIVIDE([Mature Bank Linked Users], [Mature KYC Users])

// First Deposit Conversion  |  format: 0.0%  |  Funded / bank linked.
First Deposit Conversion =
DIVIDE([Mature Funded Users], [Mature Bank Linked Users])

// First Trade Conversion  |  format: 0.0%  |  First traders / funded (activation of funded customers).
First Trade Conversion =
DIVIDE([Mature First Traders], [Mature Funded Users])

// First Trade Activation Rate  |  format: 0.0%  |  End-to-end: mature registered -> first trade.
First Trade Activation Rate =
DIVIDE([Mature First Traders], [Mature Customers])

// Active 30d Share of First Traders  |  format: 0.0%  |  Funnel stage 6 conversion.
Active 30d Share of First Traders =
DIVIDE([Mature Active 30d Traders], [Mature First Traders])

// Funnel Users  |  format: #,0  |  Users reached at the stage on the DimStage axis (disconnected table).
Funnel Users =
SWITCH(
    SELECTEDVALUE(DimStage[StageName]),
    "Registered",
    [Mature Customers],
    "KYC Completed",
    [Mature KYC Users],
    "Bank Linked",
    [Mature Bank Linked Users],
    "First Deposit",
    [Mature Funded Users],
    "First Trade",
    [Mature First Traders],
    "Active (30d)",
    [Mature Active 30d Traders],
    BLANK()
)

// Funnel Previous Stage Users  |  format: #,0  |  Users who reached the stage before the one on the axis.
Funnel Previous Stage Users =
SWITCH(
    SELECTEDVALUE(DimStage[StageName]),
    "KYC Completed",
    [Mature Customers],
    "Bank Linked",
    [Mature KYC Users],
    "First Deposit",
    [Mature Bank Linked Users],
    "First Trade",
    [Mature Funded Users],
    "Active (30d)",
    [Mature First Traders],
    BLANK()
)

// Funnel % of Registered  |  format: 0.0%  |  Stage users as a share of mature registered.
Funnel % of Registered =
DIVIDE([Funnel Users], [Mature Customers])

// Funnel Step Conversion  |  format: 0.0%  |  Stage users / previous-stage users.
Funnel Step Conversion =
DIVIDE([Funnel Users], [Funnel Previous Stage Users])

// Funnel Users Lost  |  format: #,0  |  Users lost between the previous stage and this one.
Funnel Users Lost =
IF(
    ISBLANK([Funnel Previous Stage Users]),
    BLANK(),
    [Funnel Previous Stage Users] - [Funnel Users]
)

// Funnel Drop-off Rate  |  format: 0.0%  |  Share of previous-stage users lost at this step.
Funnel Drop-off Rate =
DIVIDE([Funnel Users Lost], [Funnel Previous Stage Users])

// Total Funnel Loss  |  format: #,0  |  All users lost between registration and active-30d trader.
Total Funnel Loss =
[Mature Customers] - [Mature Active 30d Traders]

// Share of Funnel Losses  |  format: 0.0%  |  Bottleneck share: this step's losses / all losses.
Share of Funnel Losses =
DIVIDE([Funnel Users Lost], [Total Funnel Loss])

// Median Days in Stage  |  format: #,0.0  |  Median days from the previous stage (mature customers who reached the stage).
Median Days in Stage =
CALCULATE(
    SWITCH(
        SELECTEDVALUE(DimStage[StageName]),
        "KYC Completed",
        MEDIAN(FactCustomer[DaysRegToKYC]),
        "Bank Linked",
        MEDIAN(FactCustomer[DaysKYCToBank]),
        "First Deposit",
        MEDIAN(FactCustomer[DaysBankToDeposit]),
        "First Trade",
        MEDIAN(FactCustomer[DaysDepositToTrade]),
        BLANK()
    ),
    FactCustomer[FunnelMature] = 1
)

// Median Days Registration to First Trade  |  format: #,0.0  |  Median end-to-end time to first trade.
Median Days Registration to First Trade =
CALCULATE(MEDIAN(FactCustomer[DaysRegToTrade]), FactCustomer[FunnelMature] = 1)

// Funded Never Traded  |  format: #,0  |  High-potential activation pool: funded, no trade yet.
Funded Never Traded =
CALCULATE(COUNTROWS(FactCustomer), FactCustomer[Deposited] = 1, FactCustomer[Traded] = 0)

// Funded Never Traded Deposits INR  |  format: #,0  |  Sum of first deposits of funded-never-traded customers (balance sitting idle; not revenue).
Funded Never Traded Deposits INR =
CALCULATE(
    SUM(FactCustomer[FirstDepositAmountINR]),
    FactCustomer[Deposited] = 1,
    FactCustomer[Traded] = 0
)

// Stalled Onboarding Customers  |  format: #,0  |  Customers stalled beyond the historical maximum stage lag (segments 02-05).
Stalled Onboarding Customers =
CALCULATE(COUNTROWS(FactCustomer), DimSegment[SegmentKey] IN {2, 3, 4, 5})

// ==============================================================================
// Display folder: 02 Acquisition and Marketing
// ==============================================================================

// Total Campaign Spend  |  format: #,0  |  Recorded campaign spend (INR). Spend is not dated, so it ignores month/city/device/segment filters by design.
Total Campaign Spend =
SUM(DimCampaign[CampaignSpendINR])

// Paid Spend  |  format: #,0  |  Spend of campaigns with recorded spend.
Paid Spend =
CALCULATE([Total Campaign Spend], DimCampaign[IsPaid] = 1)

// Registered Customers (Full Period)  |  format: #,0  |  Registrations over the whole period; only campaign/channel filters apply. Matches the undated spend.
Registered Customers (Full Period) =
CALCULATE(
    [Registered Customers],
    REMOVEFILTERS(DimDate),
    REMOVEFILTERS(DimCity),
    REMOVEFILTERS(DimDevice),
    REMOVEFILTERS(DimSegment)
)

// Paid Registrations (Full Period)  |  format: #,0  |  Registrations from campaigns with recorded spend.
Paid Registrations (Full Period) =
CALCULATE([Registered Customers (Full Period)], DimCampaign[IsPaid] = 1)

// CAC  |  format: #,0.0  |  Customer acquisition cost = recorded spend / registered customers of paid campaigns. Blank for organic (no spend recorded) - not zero.
CAC =
DIVIDE([Total Campaign Spend], [Paid Registrations (Full Period)])

// KYC Rate (Paid, Full Period)  |  format: 0.0%  |  Mature KYC rate of the paid population in scope.
KYC Rate (Paid, Full Period) =
CALCULATE(
    [KYC Completion Rate],
    REMOVEFILTERS(DimDate),
    REMOVEFILTERS(DimCity),
    REMOVEFILTERS(DimDevice),
    REMOVEFILTERS(DimSegment),
    DimCampaign[IsPaid] = 1
)

// First Trade Rate (Paid, Full Period)  |  format: 0.0%  |  Mature first-trade rate of the paid population in scope.
First Trade Rate (Paid, Full Period) =
CALCULATE(
    [First Trade Activation Rate],
    REMOVEFILTERS(DimDate),
    REMOVEFILTERS(DimCity),
    REMOVEFILTERS(DimDevice),
    REMOVEFILTERS(DimSegment),
    DimCampaign[IsPaid] = 1
)

// Cost per KYC  |  format: #,0  |  CAC / mature KYC rate = cost per KYC-complete customer at maturity.
Cost per KYC =
DIVIDE([CAC], [KYC Rate (Paid, Full Period)])

// Cost per First Trade  |  format: #,0  |  CAC / mature first-trade rate = cost per first trader at maturity. No revenue or ROI is implied.
Cost per First Trade =
DIVIDE([CAC], [First Trade Rate (Paid, Full Period)])

// Paid Share of Registrations  |  format: 0.0%  |  Share of registrations from campaigns with recorded spend.
Paid Share of Registrations =
DIVIDE(CALCULATE([Registered Customers], DimCampaign[IsPaid] = 1), [Registered Customers])

// Registration Share  |  format: 0.0%  |  Share of selected registrations (campaign axis).
Registration Share =
DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimCampaign)))

// Spend Share  |  format: 0.0%  |  Share of selected spend.
Spend Share =
DIVIDE([Total Campaign Spend], CALCULATE([Total Campaign Spend], ALLSELECTED(DimCampaign)))

// City Share of Registrations  |  format: 0.0%  |  City axis share.
City Share of Registrations =
DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimCity)))

// Device Share of Registrations  |  format: 0.0%  |  Device axis share.
Device Share of Registrations =
DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimDevice)))

// Rank Cost per First Trade (Paid)  |  format: #,0  |  1 = lowest cost per first trader among selected paid campaigns.
Rank Cost per First Trade (Paid) =
IF(
    ISBLANK([Cost per First Trade]),
    BLANK(),
    RANKX(
        FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per First Trade]))),
        [Cost per First Trade],
        ,
        ASC,
        DENSE
    )
)

// Rank First Trade Rate  |  format: #,0  |  1 = highest mature first-trade rate among selected campaigns.
Rank First Trade Rate =
RANKX(ALLSELECTED(DimCampaign[CampaignName]), [First Trade Activation Rate], , DESC, DENSE)

// Median Paid Cost per First Trade  |  format: #,0  |  Median across selected paid campaigns (peer benchmark).
Median Paid Cost per First Trade =
MEDIANX(
    FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per First Trade]))),
    [Cost per First Trade]
)

// Median Paid Cost per KYC  |  format: #,0  |  Median across selected paid campaigns (peer benchmark for onboarding cost).
Median Paid Cost per KYC =
MEDIANX(
    FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per KYC]))),
    [Cost per KYC]
)

// Cost Efficiency Index  |  format: #,0.00  |  Peer median / own cost per first trade. Above 1 = cheaper than the median paid campaign.
Cost Efficiency Index =
DIVIDE([Median Paid Cost per First Trade], [Cost per First Trade])

// Budget Signal  |  format:   |  Indicator only: ranks cost per first trader against peers. Not a recommendation without a test (no revenue data).
Budget Signal =
SWITCH(
    TRUE(),
    ISBLANK([Cost per First Trade]),
    "Organic - no spend to optimise",
    [Cost Efficiency Index] >= [Efficient Index Threshold],
    "Efficient vs peers - protect / test scaling",
    [Cost Efficiency Index] <= [Costly Index Threshold],
    "Costly vs peers - review / test cut-back",
    "In line with peers"
)

// Evidence Strength  |  format:   |  Statistical caution carried over from Phase 3.
Evidence Strength =
IF(
    SELECTEDVALUE(DimCampaign[Phase3SignificantAt5pct]) = "Yes",
    "First-trade rate differs significantly from other campaigns (Phase 3, Holm)",
    "Not significant at 5% - treat as indicative"
)

// Phase 3 Scorecard Tier  |  format:   |  Tier assigned by the Phase 3 scorecard (static input).
Phase 3 Scorecard Tier =
SELECTEDVALUE(DimCampaign[Phase3Tier], "Multiple campaigns")

// Phase 3 Overall Score  |  format: #,0.0  |  Phase 3 composite score (paid campaigns only).
Phase 3 Overall Score =
SELECTEDVALUE(DimCampaign[Phase3OverallScore])

// CAC Scope Note  |  format:   |  Warning shown on cards when a filter the spend cannot follow is active.
CAC Scope Note =
IF(
    ISFILTERED(
        DimDate
    ) || ISFILTERED(DimCity) || ISFILTERED(DimDevice) || ISFILTERED(DimSegment),
    "Spend is not dated: CAC and cost per trade ignore month, city, device and segment filters.",
    ""
)

// ==============================================================================
// Display folder: 03 Retention and Engagement
// ==============================================================================

// Customers To Date  |  format: #,0  |  Cumulative registrations up to the last selected date.
Customers To Date =
VAR d = MAX(DimDate[Date])
RETURN
    CALCULATE([Registered Customers], FILTER(ALL(DimDate), DimDate[Date] <= d))

// MAU  |  format: #,0  |  Monthly active users of the latest month in context (Oct-2026 when unfiltered).
MAU =
VAR mth = MAX(FactActivity[ActivityMonthDate])
RETURN
    CALCULATE(SUM(FactActivity[ActiveInMonth]), FactActivity[ActivityMonthDate] = mth)

// MAU Share of Customers  |  format: 0.0%  |  MAU / customers registered by month end.
MAU Share of Customers =
VAR mth = MAX(FactActivity[ActivityMonthDate])
RETURN
    DIVIDE(
        [MAU],
        CALCULATE(
            [Registered Customers],
            FILTER(ALL(DimDate), DimDate[Date] <= EOMONTH(mth, 0))
        )
    )

// 30-Day Retention  |  format: 0.0%  |  Share active in the last 30 days among customers with tenure of at least 31 days.
30-Day Retention =
CALCULATE(AVERAGE(FactCustomer[Active30d]), FactCustomer[Eligible30d] = 1)

// Inactive 90d Rate  |  format: 0.0%  |  Share inactive for more than 90 days (proxy for churn, not confirmed churn).
Inactive 90d Rate =
CALCULATE(AVERAGE(FactCustomer[Inactive90d]), FactCustomer[Eligible90d] = 1)

// Dormant 3m Rate  |  format: 0.0%  |  Share with no active month Aug-Oct 2026, customers registered by Jul-2026 (churn proxy).
Dormant 3m Rate =
AVERAGE(FactCustomer[Dormant3m])

// Cohort Retention  |  format: 0.0%  |  Share active - use in the cohort matrix (rows RegMonthDate, columns MonthsSinceRegistration).
Cohort Retention =
AVERAGE(FactActivity[ActiveInMonth])

// Cohort Size  |  format: #,0  |  Customers in the registration cohort.
Cohort Size =
CALCULATE(DISTINCTCOUNT(FactActivity[CustomerID]), FactActivity[MonthsSinceRegistration] = 0)

// M1 Retention  |  format: 0.00%  |  Active the calendar month after registration (pooled).
M1 Retention =
CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 1)

// M3 Retention  |  format: 0.00%  |  Active 3 calendar months after the registration month (pooled).
M3 Retention =
CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 3)

// M6 Retention  |  format: 0.00%  |  Active 6 calendar months after the registration month (pooled).
M6 Retention =
CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 6)

// Inactivity Share (Eligible)  |  format: 0.0%  |  Share of 30-day-eligible customers (tenure of at least 31 days) per days-since-last-activity bucket; same base as the Phase 3 inactivity distribution.
Inactivity Share (Eligible) =
DIVIDE(
    CALCULATE(COUNTROWS(FactCustomer), FactCustomer[Eligible30d] = 1),
    CALCULATE(
        COUNTROWS(FactCustomer),
        FactCustomer[Eligible30d] = 1,
        REMOVEFILTERS(FactCustomer[InactivityBucket])
    )
)

// Trading Users  |  format: #,0  |  Customer-months with at least one trade (monthly trading users when sliced by month).
Trading Users =
SUM(FactActivity[TradedInMonth])

// Trades  |  format: #,0  |  Number of trades.
Trades =
SUM(FactActivity[TradeCount])

// Trading Value INR mn  |  format: #,0.00  |  Trading value in INR millions.
Trading Value INR mn =
DIVIDE(SUM(FactActivity[TradingValueINR]), 1000000)

// Deposits INR mn  |  format: #,0.00  |  Deposits in INR millions.
Deposits INR mn =
DIVIDE(SUM(FactActivity[DepositValueINR]), 1000000)

// Withdrawals INR mn  |  format: #,0.00  |  Withdrawals in INR millions.
Withdrawals INR mn =
DIVIDE(SUM(FactActivity[WithdrawalValueINR]), 1000000)

// Net Flow INR mn  |  format: #,0.00  |  Deposits minus withdrawals (INR millions).
Net Flow INR mn =
DIVIDE(SUM(FactActivity[NetFlowINR]), 1000000)

// Withdrawal to Deposit Ratio  |  format: 0.0%  |  Withdrawals as a share of deposits.
Withdrawal to Deposit Ratio =
DIVIDE(SUM(FactActivity[WithdrawalValueINR]), SUM(FactActivity[DepositValueINR]))

// Trades per Trading User  |  format: #,0.0  |  Average trades per trading customer-month.
Trades per Trading User =
DIVIDE([Trades], [Trading Users])

// Avg Trade Value INR  |  format: #,0  |  Average value per trade.
Avg Trade Value INR =
DIVIDE(SUM(FactActivity[TradingValueINR]), [Trades])

// Ever-Traders (Repeat Base)  |  format: #,0  |  Customers with enough history that traded in at least one month.
Ever-Traders (Repeat Base) =
CALCULATE(
    COUNTROWS(FactCustomer),
    FactCustomer[MonthsObserved] >= [Repeat Base Months],
    FactCustomer[TradeMonths] >= 1
)

// Repeat Traders  |  format: #,0  |  Customers who traded in 2+ calendar months.
Repeat Traders =
CALCULATE(
    COUNTROWS(FactCustomer),
    FactCustomer[MonthsObserved] >= [Repeat Base Months],
    FactCustomer[TradeMonths] >= [Repeat Trader Min Months]
)

// Repeat Trader Share  |  format: 0.0%  |  Repeat traders / ever-traders.
Repeat Trader Share =
DIVIDE([Repeat Traders], [Ever-Traders (Repeat Base)])

// Segment Share  |  format: 0.0%  |  Share of selected customers per segment.
Segment Share =
DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimSegment)))

// Avg 6m Trading Value INR  |  format: #,0  |  Mean trading value over the last six months.
Avg 6m Trading Value INR =
AVERAGE(FactCustomer[TradingValue6mINR])

// ==============================================================================
// Display folder: 04 Time Intelligence
// ==============================================================================

// Registered Customers PM  |  format: #,0  |  Registrations in the previous month.
Registered Customers PM =
CALCULATE([Registered Customers], DATEADD(DimDate[Date], -1, MONTH))

// Registrations MoM %  |  format: 0.0%  |  Month-over-month change in registrations (single month in context).
Registrations MoM % =
IF(HASONEVALUE(DimDate[MonthLabel]),
VAR pm = [Registered Customers PM]
RETURN
    IF(ISBLANK(pm), BLANK(), DIVIDE([Registered Customers] - pm, pm)), BLANK())

// Registrations 3M Avg  |  format: #,0.0  |  Rolling 3-month average of monthly registrations (fewer months at the start).
Registrations 3M Avg =
VAR d = MAX(DimDate[Date])
VAR win = DATESINPERIOD(DimDate[Date], d, -3, MONTH)
RETURN
    DIVIDE(
        CALCULATE([Registered Customers], win),
        CALCULATE(DISTINCTCOUNT(DimDate[MonthStart]), win)
    )

// Registered YTD  |  format: #,0  |  Calendar year-to-date registrations (data cover Nov-2025 to Oct-2026, so 2025 YTD = Nov-Dec).
Registered YTD =
CALCULATE([Registered Customers], DATESYTD(DimDate[Date]))

// MAU PM  |  format: #,0  |  MAU of the previous month.
MAU PM =
CALCULATE([MAU], DATEADD(DimDate[Date], -1, MONTH))

// MAU MoM %  |  format: 0.0%  |  Month-over-month change in MAU.
MAU MoM % =
IF(HASONEVALUE(DimDate[MonthLabel]),
VAR pm = [MAU PM]
RETURN
    IF(ISBLANK(pm), BLANK(), DIVIDE([MAU] - pm, pm)), BLANK())

// Tickets PM  |  format: #,0  |  Tickets raised in the previous month.
Tickets PM =
CALCULATE([Tickets], DATEADD(DimDate[Date], -1, MONTH))

// Tickets MoM %  |  format: 0.0%  |  Month-over-month change in ticket volume.
Tickets MoM % =
IF(HASONEVALUE(DimDate[MonthLabel]),
VAR pm = [Tickets PM]
RETURN
    IF(ISBLANK(pm), BLANK(), DIVIDE([Tickets] - pm, pm)), BLANK())

// Trading Value INR mn PM  |  format: #,0.00  |  Trading value of the previous month.
Trading Value INR mn PM =
CALCULATE([Trading Value INR mn], DATEADD(DimDate[Date], -1, MONTH))

// Trading Value MoM %  |  format: 0.0%  |  Month-over-month change in trading value.
Trading Value MoM % =
IF(HASONEVALUE(DimDate[MonthLabel]),
VAR pm = [Trading Value INR mn PM]
RETURN
    IF(ISBLANK(pm), BLANK(), DIVIDE([Trading Value INR mn] - pm, pm)), BLANK())

// ==============================================================================
// Display folder: 05 Customer Operations
// ==============================================================================

// Tickets  |  format: #,0  |  Support tickets.
Tickets =
COUNTROWS(FactTicket)

// Tickets per 1000 Customers  |  format: #,0  |  Tickets per 1,000 customers registered to date (whole period = Phase 3 definition).
Tickets per 1000 Customers =
DIVIDE([Tickets], [Customers To Date]) * 1000

// Resolved Tickets  |  format: #,0  |  Tickets with a resolution.
Resolved Tickets =
SUM(FactTicket[IsResolved])

// Unresolved Tickets  |  format: #,0  |  Open plus escalated tickets (backlog).
Unresolved Tickets =
SUM(FactTicket[IsUnresolved])

// Open Tickets  |  format: #,0  |  Tickets with status Open.
Open Tickets =
CALCULATE(COUNTROWS(FactTicket), FactTicket[Status] = "Open")

// Escalated Tickets  |  format: #,0  |  Tickets with status Escalated.
Escalated Tickets =
SUM(FactTicket[IsEscalated])

// Resolved Rate  |  format: 0.0%  |  Resolved / all tickets.
Resolved Rate =
DIVIDE([Resolved Tickets], [Tickets])

// Escalation Rate  |  format: 0.00%  |  Escalated / all tickets.
Escalation Rate =
DIVIDE([Escalated Tickets], [Tickets])

// Avg Resolution Hours  |  format: #,0.0  |  Mean hours to resolve (resolved tickets).
Avg Resolution Hours =
AVERAGE(FactTicket[ResolutionHours])

// Median Resolution Hours  |  format: #,0.0  |  Median hours to resolve (typical customer wait).
Median Resolution Hours =
MEDIAN(FactTicket[ResolutionHours])

// P90 Resolution Hours  |  format: #,0.0  |  90th percentile of resolution hours.
P90 Resolution Hours =
PERCENTILE.INC(FactTicket[ResolutionHours], 0.9)

// Within SLA Rate  |  format: 0.0%  |  Resolved within the illustrative SLA hours.
Within SLA Rate =
DIVIDE(
    CALCULATE(
        COUNTROWS(FactTicket),
        FactTicket[IsResolved] = 1,
        FactTicket[ResolutionHours] <= [SLA Hours]
    ),
    [Resolved Tickets]
)

// CSAT  |  format: #,0.00  |  Mean customer satisfaction (1-5), rated tickets only.
CSAT =
AVERAGE(FactTicket[CSAT])

// CSAT Top-Box  |  format: 0.0%  |  Share of ratings 4-5.
CSAT Top-Box =
DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[CSAT] >= 4), COUNT(FactTicket[CSAT]))

// CSAT Bottom-Box  |  format: 0.0%  |  Share of ratings 1-2.
CSAT Bottom-Box =
DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[CSAT] <= 2), COUNT(FactTicket[CSAT]))

// Backlog over 90 Days  |  format: #,0  |  Unresolved tickets older than 90 days.
Backlog over 90 Days =
CALCULATE(COUNTROWS(FactTicket), FactTicket[IsUnresolved] = 1, FactTicket[TicketAgeDays] > 90)

// Category Share  |  format: 0.0%  |  Share of tickets per category.
Category Share =
DIVIDE([Tickets], CALCULATE([Tickets], REMOVEFILTERS(FactTicket[Category])))

// Priority Share  |  format: 0.0%  |  Share of tickets per priority.
Priority Share =
DIVIDE([Tickets], CALCULATE([Tickets], REMOVEFILTERS(FactTicket[Priority])))

// High Priority Share  |  format: 0.0%  |  High-priority tickets / all tickets.
High Priority Share =
DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[Priority] = "High"), [Tickets])

// Onboarding Tickets  |  format: #,0  |  Tickets tied to an onboarding stage (KYC, bank, deposit, trade).
Onboarding Tickets =
CALCULATE(COUNTROWS(FactTicket), FactTicket[RelatedFunnelStage] <> "none")

// Tickets While Stage Pending  |  format: #,0  |  Onboarding tickets raised while the related stage was still pending.
Tickets While Stage Pending =
CALCULATE(COUNTROWS(FactTicket), FactTicket[StagePendingAtTicket] = 1)

// Pending Stage Ticket Share  |  format: 0.0%  |  Share of onboarding tickets raised while the stage was pending.
Pending Stage Ticket Share =
DIVIDE([Tickets While Stage Pending], [Onboarding Tickets])

// ==============================================================================
// Display folder: 06 Labels and Notes
// ==============================================================================

// Mature Cohort Note  |  format:   |  Footnote for funnel visuals.
Mature Cohort Note =
"Funnel rates use the mature cohort (registered before Oct-2026): n = " & FORMAT(
    [Mature Customers],
    "#,0"
)

// Data Disclaimer  |  format:   |  Footer on every page.
Data Disclaimer =
"Synthetic data - fictional Indian retail brokerage; not real customer data."

// Proxy Note  |  format:   |  Footnote for retention visuals.
Proxy Note =
"Inactive 90d and Dormant 3m are churn proxies, not confirmed churn."
