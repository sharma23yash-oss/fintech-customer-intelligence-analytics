	partition FactCustomer = m
		mode: import
		source =
				let
				    Source   = Csv.Document(File.Contents(DataFolder & "\FactCustomer.csv"), [Delimiter = ",", Columns = 42, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed    = Table.TransformColumnTypes(Promoted, {{"CustomerID", type text}, {"RegistrationDate", type date}, {"CampaignKey", type text}, {"CityKey", type text}, {"DeviceKey", type text}, {"SegmentKey", Int64.Type}, {"AgeGroup", type text}, {"RiskProfile", type text}, {"FurthestStage", type text}, {"KYCDone", Int64.Type}, {"BankLinked", Int64.Type}, {"Deposited", Int64.Type}, {"Traded", Int64.Type}, {"KYCDate", type date}, {"BankDate", type date}, {"DepositDate", type date}, {"FirstTradeDate", type date}, {"FirstDepositAmountINR", type number}, {"FunnelMature", Int64.Type}, {"Eligible30d", Int64.Type}, {"Eligible90d", Int64.Type}, {"DaysRegToKYC", Int64.Type}, {"DaysKYCToBank", Int64.Type}, {"DaysBankToDeposit", Int64.Type}, {"DaysDepositToTrade", Int64.Type}, {"DaysRegToTrade", Int64.Type}, {"Active30d", Int64.Type}, {"Inactive90d", Int64.Type}, {"TenureDays", Int64.Type}, {"MonthsObserved", Int64.Type}, {"TradeMonths", Int64.Type}, {"TradeMonths6m", Int64.Type}, {"TradingValue6mINR", type number}, {"Dormant3m", Int64.Type}, {"M1Retained", Int64.Type}, {"M3Retained", Int64.Type}, {"M6Retained", Int64.Type}, {"TicketCount", Int64.Type}, {"UnresolvedTicketCount", Int64.Type}, {"DaysSinceLastActivity", Int64.Type}, {"InactivityBucket", type text}, {"InactivitySort", Int64.Type}}, "en-US")
				in
				    Typed
