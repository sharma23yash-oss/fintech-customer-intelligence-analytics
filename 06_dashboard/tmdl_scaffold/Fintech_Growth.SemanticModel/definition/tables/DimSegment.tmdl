table DimSegment

	column SegmentKey
		dataType: int64
		summarizeBy: none
		sourceColumn: SegmentKey

	column SegmentName
		dataType: string
		summarizeBy: none
		sourceColumn: SegmentName

	column SegmentGroup
		dataType: string
		summarizeBy: none
		sourceColumn: SegmentGroup

	column RecommendedAction
		dataType: string
		summarizeBy: none
		sourceColumn: RecommendedAction

	partition DimSegment = m
		mode: import
		source =
				let
				    Source   = Csv.Document(File.Contents(DataFolder & "\DimSegment.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed    = Table.TransformColumnTypes(Promoted, {{"SegmentKey", Int64.Type}, {"SegmentName", type text}, {"SegmentGroup", type text}, {"RecommendedAction", type text}}, "en-US")
				in
				    Typed
