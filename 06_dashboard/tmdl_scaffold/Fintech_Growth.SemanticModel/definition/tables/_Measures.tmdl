table _Measures

	measure 'Snapshot Date' = DATE(2026, 10, 31)
		formatString: yyyy-mm-dd
		displayFolder: 00 Parameters
		description: Data cut-off; all *_asof columns count events on or before this date.

	measure 'SLA Hours' = 24
		formatString: #,0
		displayFolder: 00 Parameters
		description: Illustrative internal resolution SLA (hours). Not a regulatory figure.

	measure 'Efficient Index Threshold' = 1.15
		formatString: #,0.00
		displayFolder: 00 Parameters
		description: Cost Efficiency Index at or above this = efficient vs paid peers.

	measure 'Costly Index Threshold' = 0.85
		formatString: #,0.00
		displayFolder: 00 Parameters
		description: Cost Efficiency Index at or below this = costly vs paid peers.

	measure 'Repeat Base Months' = 4
		formatString: #,0
		displayFolder: 00 Parameters
		description: Customers need this many observed months to be judged on repeat trading.

	measure 'Repeat Trader Min Months' = 2
		formatString: #,0
		displayFolder: 00 Parameters
		description: Trading in at least this many calendar months = repeat trader.

	measure 'Registered Customers' = COUNTROWS(FactCustomer)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Customers registered (all cohorts).

	measure 'Mature Customers' = CALCULATE(COUNTROWS(FactCustomer), FactCustomer[FunnelMature] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Customers registered before Oct-2026; denominator for funnel rates.

	measure 'Mature KYC Users' = CALCULATE(SUM(FactCustomer[KYCDone]), FactCustomer[FunnelMature] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Mature customers with KYC completed (as of snapshot).

	measure 'Mature Bank Linked Users' = CALCULATE(SUM(FactCustomer[BankLinked]), FactCustomer[FunnelMature] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Mature customers with a bank account linked.

	measure 'Mature Funded Users' = CALCULATE(SUM(FactCustomer[Deposited]), FactCustomer[FunnelMature] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Mature customers who made a first deposit.

	measure 'Mature First Traders' = CALCULATE(SUM(FactCustomer[Traded]), FactCustomer[FunnelMature] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Mature customers who placed a first trade.

	measure 'Mature Active 30d Traders' = CALCULATE(COUNTROWS(FactCustomer), FactCustomer[FunnelMature] = 1, FactCustomer[Traded] = 1, FactCustomer[Active30d] = 1)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Mature first traders active in the last 30 days (funnel stage 6).

	measure 'KYC Completion Rate' = DIVIDE([Mature KYC Users], [Mature Customers])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: KYC completed / mature registered.

	measure 'Bank Link Conversion' = DIVIDE([Mature Bank Linked Users], [Mature KYC Users])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Bank linked / KYC completed.

	measure 'First Deposit Conversion' = DIVIDE([Mature Funded Users], [Mature Bank Linked Users])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Funded / bank linked.

	measure 'First Trade Conversion' = DIVIDE([Mature First Traders], [Mature Funded Users])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: First traders / funded (activation of funded customers).

	measure 'First Trade Activation Rate' = DIVIDE([Mature First Traders], [Mature Customers])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: End-to-end: mature registered -> first trade.

	measure 'Active 30d Share of First Traders' = DIVIDE([Mature Active 30d Traders], [Mature First Traders])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Funnel stage 6 conversion.

	measure 'Funnel Users' = SWITCH(SELECTEDVALUE(DimStage[StageName]), "Registered", [Mature Customers], "KYC Completed", [Mature KYC Users], "Bank Linked", [Mature Bank Linked Users], "First Deposit", [Mature Funded Users], "First Trade", [Mature First Traders], "Active (30d)", [Mature Active 30d Traders], BLANK())
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Users reached at the stage on the DimStage axis (disconnected table).

	measure 'Funnel Previous Stage Users' = SWITCH(SELECTEDVALUE(DimStage[StageName]), "KYC Completed", [Mature Customers], "Bank Linked", [Mature KYC Users], "First Deposit", [Mature Bank Linked Users], "First Trade", [Mature Funded Users], "Active (30d)", [Mature First Traders], BLANK())
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Users who reached the stage before the one on the axis.

	measure 'Funnel % of Registered' = DIVIDE([Funnel Users], [Mature Customers])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Stage users as a share of mature registered.

	measure 'Funnel Step Conversion' = DIVIDE([Funnel Users], [Funnel Previous Stage Users])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Stage users / previous-stage users.

	measure 'Funnel Users Lost' = IF(ISBLANK([Funnel Previous Stage Users]), BLANK(), [Funnel Previous Stage Users] - [Funnel Users])
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Users lost between the previous stage and this one.

	measure 'Funnel Drop-off Rate' = DIVIDE([Funnel Users Lost], [Funnel Previous Stage Users])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Share of previous-stage users lost at this step.

	measure 'Total Funnel Loss' = [Mature Customers] - [Mature Active 30d Traders]
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: All users lost between registration and active-30d trader.

	measure 'Share of Funnel Losses' = DIVIDE([Funnel Users Lost], [Total Funnel Loss])
		formatString: 0.0%
		displayFolder: 01 Customers and Funnel
		description: Bottleneck share: this step's losses / all losses.

	measure 'Median Days in Stage' = CALCULATE(SWITCH(SELECTEDVALUE(DimStage[StageName]), "KYC Completed", MEDIAN(FactCustomer[DaysRegToKYC]), "Bank Linked", MEDIAN(FactCustomer[DaysKYCToBank]), "First Deposit", MEDIAN(FactCustomer[DaysBankToDeposit]), "First Trade", MEDIAN(FactCustomer[DaysDepositToTrade]), BLANK()), FactCustomer[FunnelMature] = 1)
		formatString: #,0.0
		displayFolder: 01 Customers and Funnel
		description: Median days from the previous stage (mature customers who reached the stage).

	measure 'Median Days Registration to First Trade' = CALCULATE(MEDIAN(FactCustomer[DaysRegToTrade]), FactCustomer[FunnelMature] = 1)
		formatString: #,0.0
		displayFolder: 01 Customers and Funnel
		description: Median end-to-end time to first trade.

	measure 'Funded Never Traded' = CALCULATE(COUNTROWS(FactCustomer), FactCustomer[Deposited] = 1, FactCustomer[Traded] = 0)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: High-potential activation pool: funded, no trade yet.

	measure 'Funded Never Traded Deposits INR' = CALCULATE(SUM(FactCustomer[FirstDepositAmountINR]), FactCustomer[Deposited] = 1, FactCustomer[Traded] = 0)
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Sum of first deposits of funded-never-traded customers (balance sitting idle; not revenue).

	measure 'Stalled Onboarding Customers' = CALCULATE(COUNTROWS(FactCustomer), DimSegment[SegmentKey] IN {2, 3, 4, 5})
		formatString: #,0
		displayFolder: 01 Customers and Funnel
		description: Customers stalled beyond the historical maximum stage lag (segments 02-05).

	measure 'Total Campaign Spend' = SUM(DimCampaign[CampaignSpendINR])
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Recorded campaign spend (INR). Spend is not dated, so it ignores month/city/device/segment filters by design.

	measure 'Paid Spend' = CALCULATE([Total Campaign Spend], DimCampaign[IsPaid] = 1)
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Spend of campaigns with recorded spend.

	measure 'Registered Customers (Full Period)' = CALCULATE([Registered Customers], REMOVEFILTERS(DimDate), REMOVEFILTERS(DimCity), REMOVEFILTERS(DimDevice), REMOVEFILTERS(DimSegment))
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Registrations over the whole period; only campaign/channel filters apply. Matches the undated spend.

	measure 'Paid Registrations (Full Period)' = CALCULATE([Registered Customers (Full Period)], DimCampaign[IsPaid] = 1)
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Registrations from campaigns with recorded spend.

	measure CAC = DIVIDE([Total Campaign Spend], [Paid Registrations (Full Period)])
		formatString: #,0.0
		displayFolder: 02 Acquisition and Marketing
		description: Customer acquisition cost = recorded spend / registered customers of paid campaigns. Blank for organic (no spend recorded) - not zero.

	measure 'KYC Rate (Paid, Full Period)' = CALCULATE([KYC Completion Rate], REMOVEFILTERS(DimDate), REMOVEFILTERS(DimCity), REMOVEFILTERS(DimDevice), REMOVEFILTERS(DimSegment), DimCampaign[IsPaid] = 1)
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Mature KYC rate of the paid population in scope.

	measure 'First Trade Rate (Paid, Full Period)' = CALCULATE([First Trade Activation Rate], REMOVEFILTERS(DimDate), REMOVEFILTERS(DimCity), REMOVEFILTERS(DimDevice), REMOVEFILTERS(DimSegment), DimCampaign[IsPaid] = 1)
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Mature first-trade rate of the paid population in scope.

	measure 'Cost per KYC' = DIVIDE([CAC], [KYC Rate (Paid, Full Period)])
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: CAC / mature KYC rate = cost per KYC-complete customer at maturity.

	measure 'Cost per First Trade' = DIVIDE([CAC], [First Trade Rate (Paid, Full Period)])
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: CAC / mature first-trade rate = cost per first trader at maturity. No revenue or ROI is implied.

	measure 'Paid Share of Registrations' = DIVIDE(CALCULATE([Registered Customers], DimCampaign[IsPaid] = 1), [Registered Customers])
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Share of registrations from campaigns with recorded spend.

	measure 'Registration Share' = DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimCampaign)))
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Share of selected registrations (campaign axis).

	measure 'Spend Share' = DIVIDE([Total Campaign Spend], CALCULATE([Total Campaign Spend], ALLSELECTED(DimCampaign)))
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Share of selected spend.

	measure 'City Share of Registrations' = DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimCity)))
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: City axis share.

	measure 'Device Share of Registrations' = DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimDevice)))
		formatString: 0.0%
		displayFolder: 02 Acquisition and Marketing
		description: Device axis share.

	measure 'Rank Cost per First Trade (Paid)' = IF(ISBLANK([Cost per First Trade]), BLANK(), RANKX(FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per First Trade]))), [Cost per First Trade], , ASC, DENSE))
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: 1 = lowest cost per first trader among selected paid campaigns.

	measure 'Rank First Trade Rate' = RANKX(ALLSELECTED(DimCampaign[CampaignName]), [First Trade Activation Rate], , DESC, DENSE)
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: 1 = highest mature first-trade rate among selected campaigns.

	measure 'Median Paid Cost per First Trade' = MEDIANX(FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per First Trade]))), [Cost per First Trade])
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Median across selected paid campaigns (peer benchmark).

	measure 'Median Paid Cost per KYC' = MEDIANX(FILTER(ALLSELECTED(DimCampaign[CampaignName]), NOT(ISBLANK([Cost per KYC]))), [Cost per KYC])
		formatString: #,0
		displayFolder: 02 Acquisition and Marketing
		description: Median across selected paid campaigns (peer benchmark for onboarding cost).

	measure 'Cost Efficiency Index' = DIVIDE([Median Paid Cost per First Trade], [Cost per First Trade])
		formatString: #,0.00
		displayFolder: 02 Acquisition and Marketing
		description: Peer median / own cost per first trade. Above 1 = cheaper than the median paid campaign.

	measure 'Budget Signal' = SWITCH(TRUE(), ISBLANK([Cost per First Trade]), "Organic - no spend to optimise", [Cost Efficiency Index] >= [Efficient Index Threshold], "Efficient vs peers - protect / test scaling", [Cost Efficiency Index] <= [Costly Index Threshold], "Costly vs peers - review / test cut-back", "In line with peers")
		formatString: General
		displayFolder: 02 Acquisition and Marketing
		description: Indicator only: ranks cost per first trader against peers. Not a recommendation without a test (no revenue data).

	measure 'Evidence Strength' = IF(SELECTEDVALUE(DimCampaign[Phase3SignificantAt5pct]) = "Yes", "First-trade rate differs significantly from other campaigns (Phase 3, Holm)", "Not significant at 5% - treat as indicative")
		formatString: General
		displayFolder: 02 Acquisition and Marketing
		description: Statistical caution carried over from Phase 3.

	measure 'Phase 3 Scorecard Tier' = SELECTEDVALUE(DimCampaign[Phase3Tier], "Multiple campaigns")
		formatString: General
		displayFolder: 02 Acquisition and Marketing
		description: Tier assigned by the Phase 3 scorecard (static input).

	measure 'Phase 3 Overall Score' = SELECTEDVALUE(DimCampaign[Phase3OverallScore])
		formatString: #,0.0
		displayFolder: 02 Acquisition and Marketing
		description: Phase 3 composite score (paid campaigns only).

	measure 'CAC Scope Note' = IF(ISFILTERED(DimDate) || ISFILTERED(DimCity) || ISFILTERED(DimDevice) || ISFILTERED(DimSegment), "Spend is not dated: CAC and cost per trade ignore month, city, device and segment filters.", "")
		formatString: General
		displayFolder: 02 Acquisition and Marketing
		description: Warning shown on cards when a filter the spend cannot follow is active.

	measure 'Customers To Date' = VAR d = MAX(DimDate[Date]) RETURN CALCULATE([Registered Customers], FILTER(ALL(DimDate), DimDate[Date] <= d))
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Cumulative registrations up to the last selected date.

	measure MAU = VAR mth = MAX(FactActivity[ActivityMonthDate]) RETURN CALCULATE(SUM(FactActivity[ActiveInMonth]), FactActivity[ActivityMonthDate] = mth)
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Monthly active users of the latest month in context (Oct-2026 when unfiltered).

	measure 'MAU Share of Customers' = VAR mth = MAX(FactActivity[ActivityMonthDate]) RETURN DIVIDE([MAU], CALCULATE([Registered Customers], FILTER(ALL(DimDate), DimDate[Date] <= EOMONTH(mth, 0))))
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: MAU / customers registered by month end.

	measure '30-Day Retention' = CALCULATE(AVERAGE(FactCustomer[Active30d]), FactCustomer[Eligible30d] = 1)
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share active in the last 30 days among customers with tenure of at least 31 days.

	measure 'Inactive 90d Rate' = CALCULATE(AVERAGE(FactCustomer[Inactive90d]), FactCustomer[Eligible90d] = 1)
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share inactive for more than 90 days (proxy for churn, not confirmed churn).

	measure 'Dormant 3m Rate' = AVERAGE(FactCustomer[Dormant3m])
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share with no active month Aug-Oct 2026, customers registered by Jul-2026 (churn proxy).

	measure 'Cohort Retention' = AVERAGE(FactActivity[ActiveInMonth])
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share active - use in the cohort matrix (rows RegMonthDate, columns MonthsSinceRegistration).

	measure 'Cohort Size' = CALCULATE(DISTINCTCOUNT(FactActivity[CustomerID]), FactActivity[MonthsSinceRegistration] = 0)
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Customers in the registration cohort.

	measure 'M1 Retention' = CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 1)
		formatString: 0.00%
		displayFolder: 03 Retention and Engagement
		description: Active the calendar month after registration (pooled).

	measure 'M3 Retention' = CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 3)
		formatString: 0.00%
		displayFolder: 03 Retention and Engagement
		description: Active 3 calendar months after the registration month (pooled).

	measure 'M6 Retention' = CALCULATE(AVERAGE(FactActivity[ActiveInMonth]), FactActivity[MonthsSinceRegistration] = 6)
		formatString: 0.00%
		displayFolder: 03 Retention and Engagement
		description: Active 6 calendar months after the registration month (pooled).

	measure 'Inactivity Share (Eligible)' = DIVIDE(CALCULATE(COUNTROWS(FactCustomer), FactCustomer[Eligible30d] = 1), CALCULATE(COUNTROWS(FactCustomer), FactCustomer[Eligible30d] = 1, REMOVEFILTERS(FactCustomer[InactivityBucket])))
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share of 30-day-eligible customers (tenure of at least 31 days) per days-since-last-activity bucket; same base as the Phase 3 inactivity distribution.

	measure 'Trading Users' = SUM(FactActivity[TradedInMonth])
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Customer-months with at least one trade (monthly trading users when sliced by month).

	measure Trades = SUM(FactActivity[TradeCount])
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Number of trades.

	measure 'Trading Value INR mn' = DIVIDE(SUM(FactActivity[TradingValueINR]), 1000000)
		formatString: #,0.00
		displayFolder: 03 Retention and Engagement
		description: Trading value in INR millions.

	measure 'Deposits INR mn' = DIVIDE(SUM(FactActivity[DepositValueINR]), 1000000)
		formatString: #,0.00
		displayFolder: 03 Retention and Engagement
		description: Deposits in INR millions.

	measure 'Withdrawals INR mn' = DIVIDE(SUM(FactActivity[WithdrawalValueINR]), 1000000)
		formatString: #,0.00
		displayFolder: 03 Retention and Engagement
		description: Withdrawals in INR millions.

	measure 'Net Flow INR mn' = DIVIDE(SUM(FactActivity[NetFlowINR]), 1000000)
		formatString: #,0.00
		displayFolder: 03 Retention and Engagement
		description: Deposits minus withdrawals (INR millions).

	measure 'Withdrawal to Deposit Ratio' = DIVIDE(SUM(FactActivity[WithdrawalValueINR]), SUM(FactActivity[DepositValueINR]))
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Withdrawals as a share of deposits.

	measure 'Trades per Trading User' = DIVIDE([Trades], [Trading Users])
		formatString: #,0.0
		displayFolder: 03 Retention and Engagement
		description: Average trades per trading customer-month.

	measure 'Avg Trade Value INR' = DIVIDE(SUM(FactActivity[TradingValueINR]), [Trades])
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Average value per trade.

	measure 'Ever-Traders (Repeat Base)' = CALCULATE(COUNTROWS(FactCustomer), FactCustomer[MonthsObserved] >= [Repeat Base Months], FactCustomer[TradeMonths] >= 1)
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Customers with enough history that traded in at least one month.

	measure 'Repeat Traders' = CALCULATE(COUNTROWS(FactCustomer), FactCustomer[MonthsObserved] >= [Repeat Base Months], FactCustomer[TradeMonths] >= [Repeat Trader Min Months])
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Customers who traded in 2+ calendar months.

	measure 'Repeat Trader Share' = DIVIDE([Repeat Traders], [Ever-Traders (Repeat Base)])
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Repeat traders / ever-traders.

	measure 'Segment Share' = DIVIDE([Registered Customers], CALCULATE([Registered Customers], ALLSELECTED(DimSegment)))
		formatString: 0.0%
		displayFolder: 03 Retention and Engagement
		description: Share of selected customers per segment.

	measure 'Avg 6m Trading Value INR' = AVERAGE(FactCustomer[TradingValue6mINR])
		formatString: #,0
		displayFolder: 03 Retention and Engagement
		description: Mean trading value over the last six months.

	measure 'Registered Customers PM' = CALCULATE([Registered Customers], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,0
		displayFolder: 04 Time Intelligence
		description: Registrations in the previous month.

	measure 'Registrations MoM %' = IF(HASONEVALUE(DimDate[MonthLabel]), VAR pm = [Registered Customers PM] RETURN IF(ISBLANK(pm), BLANK(), DIVIDE([Registered Customers] - pm, pm)), BLANK())
		formatString: 0.0%
		displayFolder: 04 Time Intelligence
		description: Month-over-month change in registrations (single month in context).

	measure 'Registrations 3M Avg' = VAR d = MAX(DimDate[Date]) VAR win = DATESINPERIOD(DimDate[Date], d, -3, MONTH) RETURN DIVIDE(CALCULATE([Registered Customers], win), CALCULATE(DISTINCTCOUNT(DimDate[MonthStart]), win))
		formatString: #,0.0
		displayFolder: 04 Time Intelligence
		description: Rolling 3-month average of monthly registrations (fewer months at the start).

	measure 'Registered YTD' = CALCULATE([Registered Customers], DATESYTD(DimDate[Date]))
		formatString: #,0
		displayFolder: 04 Time Intelligence
		description: Calendar year-to-date registrations (data cover Nov-2025 to Oct-2026, so 2025 YTD = Nov-Dec).

	measure 'MAU PM' = CALCULATE([MAU], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,0
		displayFolder: 04 Time Intelligence
		description: MAU of the previous month.

	measure 'MAU MoM %' = IF(HASONEVALUE(DimDate[MonthLabel]), VAR pm = [MAU PM] RETURN IF(ISBLANK(pm), BLANK(), DIVIDE([MAU] - pm, pm)), BLANK())
		formatString: 0.0%
		displayFolder: 04 Time Intelligence
		description: Month-over-month change in MAU.

	measure 'Tickets PM' = CALCULATE([Tickets], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,0
		displayFolder: 04 Time Intelligence
		description: Tickets raised in the previous month.

	measure 'Tickets MoM %' = IF(HASONEVALUE(DimDate[MonthLabel]), VAR pm = [Tickets PM] RETURN IF(ISBLANK(pm), BLANK(), DIVIDE([Tickets] - pm, pm)), BLANK())
		formatString: 0.0%
		displayFolder: 04 Time Intelligence
		description: Month-over-month change in ticket volume.

	measure 'Trading Value INR mn PM' = CALCULATE([Trading Value INR mn], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		description: Trading value of the previous month.

	measure 'Trading Value MoM %' = IF(HASONEVALUE(DimDate[MonthLabel]), VAR pm = [Trading Value INR mn PM] RETURN IF(ISBLANK(pm), BLANK(), DIVIDE([Trading Value INR mn] - pm, pm)), BLANK())
		formatString: 0.0%
		displayFolder: 04 Time Intelligence
		description: Month-over-month change in trading value.

	measure Tickets = COUNTROWS(FactTicket)
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Support tickets.

	measure 'Tickets per 1000 Customers' = DIVIDE([Tickets], [Customers To Date]) * 1000
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Tickets per 1,000 customers registered to date (whole period = Phase 3 definition).

	measure 'Resolved Tickets' = SUM(FactTicket[IsResolved])
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Tickets with a resolution.

	measure 'Unresolved Tickets' = SUM(FactTicket[IsUnresolved])
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Open plus escalated tickets (backlog).

	measure 'Open Tickets' = CALCULATE(COUNTROWS(FactTicket), FactTicket[Status] = "Open")
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Tickets with status Open.

	measure 'Escalated Tickets' = SUM(FactTicket[IsEscalated])
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Tickets with status Escalated.

	measure 'Resolved Rate' = DIVIDE([Resolved Tickets], [Tickets])
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Resolved / all tickets.

	measure 'Escalation Rate' = DIVIDE([Escalated Tickets], [Tickets])
		formatString: 0.00%
		displayFolder: 05 Customer Operations
		description: Escalated / all tickets.

	measure 'Avg Resolution Hours' = AVERAGE(FactTicket[ResolutionHours])
		formatString: #,0.0
		displayFolder: 05 Customer Operations
		description: Mean hours to resolve (resolved tickets).

	measure 'Median Resolution Hours' = MEDIAN(FactTicket[ResolutionHours])
		formatString: #,0.0
		displayFolder: 05 Customer Operations
		description: Median hours to resolve (typical customer wait).

	measure 'P90 Resolution Hours' = PERCENTILE.INC(FactTicket[ResolutionHours], 0.9)
		formatString: #,0.0
		displayFolder: 05 Customer Operations
		description: 90th percentile of resolution hours.

	measure 'Within SLA Rate' = DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[IsResolved] = 1, FactTicket[ResolutionHours] <= [SLA Hours]), [Resolved Tickets])
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Resolved within the illustrative SLA hours.

	measure CSAT = AVERAGE(FactTicket[CSAT])
		formatString: #,0.00
		displayFolder: 05 Customer Operations
		description: Mean customer satisfaction (1-5), rated tickets only.

	measure 'CSAT Top-Box' = DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[CSAT] >= 4), COUNT(FactTicket[CSAT]))
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Share of ratings 4-5.

	measure 'CSAT Bottom-Box' = DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[CSAT] <= 2), COUNT(FactTicket[CSAT]))
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Share of ratings 1-2.

	measure 'Backlog over 90 Days' = CALCULATE(COUNTROWS(FactTicket), FactTicket[IsUnresolved] = 1, FactTicket[TicketAgeDays] > 90)
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Unresolved tickets older than 90 days.

	measure 'Category Share' = DIVIDE([Tickets], CALCULATE([Tickets], REMOVEFILTERS(FactTicket[Category])))
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Share of tickets per category.

	measure 'Priority Share' = DIVIDE([Tickets], CALCULATE([Tickets], REMOVEFILTERS(FactTicket[Priority])))
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Share of tickets per priority.

	measure 'High Priority Share' = DIVIDE(CALCULATE(COUNTROWS(FactTicket), FactTicket[Priority] = "High"), [Tickets])
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: High-priority tickets / all tickets.

	measure 'Onboarding Tickets' = CALCULATE(COUNTROWS(FactTicket), FactTicket[RelatedFunnelStage] <> "none")
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Tickets tied to an onboarding stage (KYC, bank, deposit, trade).

	measure 'Tickets While Stage Pending' = CALCULATE(COUNTROWS(FactTicket), FactTicket[StagePendingAtTicket] = 1)
		formatString: #,0
		displayFolder: 05 Customer Operations
		description: Onboarding tickets raised while the related stage was still pending.

	measure 'Pending Stage Ticket Share' = DIVIDE([Tickets While Stage Pending], [Onboarding Tickets])
		formatString: 0.0%
		displayFolder: 05 Customer Operations
		description: Share of onboarding tickets raised while the stage was pending.

	measure 'Mature Cohort Note' = "Funnel rates use the mature cohort (registered before Oct-2026): n = " & FORMAT([Mature Customers], "#,0")
		formatString: General
		displayFolder: 06 Labels and Notes
		description: Footnote for funnel visuals.

	measure 'Data Disclaimer' = "Synthetic data - fictional Indian retail brokerage; not real customer data."
		formatString: General
		displayFolder: 06 Labels and Notes
		description: Footer on every page.

	measure 'Proxy Note' = "Inactive 90d and Dormant 3m are churn proxies, not confirmed churn."
		formatString: General
		displayFolder: 06 Labels and Notes
		description: Footnote for retention visuals.

	column Placeholder
		dataType: string
		isHidden
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", BLANK())
